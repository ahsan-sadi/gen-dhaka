# Copy to `.env` locally. On Vercel set the same names under
# Project → Settings → Environment Variables (they are inlined at build time).

# REQUIRED — base URL of the Express API. No trailing slash.
# local:  http://localhost:8000
# prod:   https://bafwwa-gen-dhaka-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Not read by the app (yet) --------------------------------------------
# Auth is JWT issued by the Express API (lib/api.js) and payments are not
# wired up, so these are unused. Keep them locally if you like; they are not
# needed on Vercel.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
# MONGO_URI=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
